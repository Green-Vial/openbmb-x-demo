// SPDX-License-Identifier: Apache-2.0
/* P28: FusedAdaLN — AscendC kernel for the CosyVoice2 DiT adaLN-Zero pattern.
 *
 * Per row (512 fp32 elements, last-dim layernorm):
 *   mode 1:  out = x + gate * (LayerNorm(x) * (1 + scale) + shift)
 *   mode 0:  out =       LayerNorm(x) * (1 + scale) + shift
 *
 * eps = 1e-6, matching torch.nn.LayerNorm(elementwise_affine=False, eps=1e-6).
 * shift/scale/gate are broadcast along the last dim; the kernel reads one
 * 512-wide param row per batch index (row -> batch via totalRows/chunkT).
 *
 * Strategy: one AIV core processes a contiguous slice of rows. Each row is
 * copied to UB, the mean/variance are reduced with the on-chip ReduceSum,
 * and the affine + gate chain stays in UB until a single store.
 *
 * NOTE on params: shift/scale/gate rows are shared by all T rows of a batch
 * element, but they are re-copied through the TQue cycle every row instead
 * of being cached in a held LocalTensor. Holding a DeQue'd tensor across
 * iterations and freeing it on batch change leaves a window where the next
 * DataCopy overwrites the UB buffer while the vector pipe is still draining
 * the previous row's reads (queue depth 1 only orders at issue time), which
 * showed up as intermittent wrong-param outputs. The canonical per-row
 * Alloc/Copy/EnQue/DeQue/Free cycle with double buffering is race-free and
 * the extra MTE2 traffic (2-3 x 2 KB per row) is negligible here.
 */
#include "kernel_operator.h"
#include "lz_adaln_tiling.h"

namespace {
constexpr float LZ_ADALN_EPS = 1e-6f;
constexpr uint32_t LZ_ADALN_PARAM_DEPTH = 2;
}  // namespace

class FusedAdaLNGate {
public:
    __aicore__ inline explicit FusedAdaLNGate(AscendC::TPipe* pipe) : pipe_(pipe) {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR shift, GM_ADDR scale, GM_ADDR gate, GM_ADDR y,
                                const __gm__ AdaLNTilingData* tiling)
    {
        const uint32_t blockIdx = AscendC::GetBlockIdx();
        const uint32_t begin = blockIdx * tiling->rowsPerCore;
        if (begin >= tiling->totalRows) {
            rowCount_ = 0;
        } else {
            const uint32_t left = tiling->totalRows - begin;
            rowCount_ = left < tiling->rowsPerCore ? left : tiling->rowsPerCore;
        }
        rowBegin_ = begin;
        chunkT_ = tiling->chunkT;
        paramStride_ = tiling->paramStride;
        mode_ = tiling->mode;
        xBase_ = (__gm__ float*)x;
        yBase_ = (__gm__ float*)y;
        shiftBase_ = (__gm__ float*)shift;
        scaleBase_ = (__gm__ float*)scale;
        gateBase_ = (__gm__ float*)gate;

        pipe_->InitBuffer(inQueueX_, 2, LZ_ADALN_ROW_BYTES);
        pipe_->InitBuffer(outQueueY_, 2, LZ_ADALN_ROW_BYTES);
        pipe_->InitBuffer(inQueueShift_, LZ_ADALN_PARAM_DEPTH, LZ_ADALN_ROW_BYTES);
        pipe_->InitBuffer(inQueueScale_, LZ_ADALN_PARAM_DEPTH, LZ_ADALN_ROW_BYTES);
        pipe_->InitBuffer(inQueueGate_, LZ_ADALN_PARAM_DEPTH, LZ_ADALN_ROW_BYTES);
        pipe_->InitBuffer(bufW1_, LZ_ADALN_ROW_BYTES);
        pipe_->InitBuffer(bufW2_, LZ_ADALN_ROW_BYTES);
        pipe_->InitBuffer(bufReduce_, 32);
        // ReduceSum's internal temp usage scales with the reduction length
        // (official softmax templates reserve 8x the row); undersizing it
        // overwrites adjacent UB buffers and shows up as rare vector-core
        // exceptions. 8 * 2 KB is cheap insurance.
        pipe_->InitBuffer(bufReduceTmp_, 8 * LZ_ADALN_ROW_BYTES);
    }

    __aicore__ inline void Process()
    {
        for (uint32_t i = 0; i < rowCount_; i++) {
            ProcessRow(rowBegin_ + i);
        }
    }

private:
    __aicore__ inline AscendC::LocalTensor<float> AllocAndCopy(
        AscendC::TQue<AscendC::TPosition::VECIN, LZ_ADALN_PARAM_DEPTH>& queue,
        __gm__ float* base, uint32_t b)
    {
        AscendC::GlobalTensor<float> gm;
        gm.SetGlobalBuffer(base + static_cast<int64_t>(b) * paramStride_, LZ_ADALN_ROW_LEN);
        AscendC::LocalTensor<float> local = queue.AllocTensor<float>();
        AscendC::DataCopy(local, gm, LZ_ADALN_ROW_LEN);
        queue.EnQue(local);
        return queue.DeQue<float>();
    }

    __aicore__ inline void ProcessRow(uint32_t row)
    {
        const uint32_t b = row / chunkT_;

        AscendC::GlobalTensor<float> xGm;
        xGm.SetGlobalBuffer(xBase_ + static_cast<int64_t>(row) * LZ_ADALN_ROW_LEN, LZ_ADALN_ROW_LEN);
        AscendC::LocalTensor<float> xLocal = inQueueX_.AllocTensor<float>();
        AscendC::DataCopy(xLocal, xGm, LZ_ADALN_ROW_LEN);
        inQueueX_.EnQue(xLocal);
        xLocal = inQueueX_.DeQue<float>();

        AscendC::LocalTensor<float> shiftLocal = AllocAndCopy(inQueueShift_, shiftBase_, b);
        AscendC::LocalTensor<float> scaleLocal = AllocAndCopy(inQueueScale_, scaleBase_, b);
        AscendC::LocalTensor<float> gateLocal;
        if (mode_ == LZ_ADALN_MODE_GATE_RESIDUAL) {
            gateLocal = AllocAndCopy(inQueueGate_, gateBase_, b);
        }

        AscendC::LocalTensor<float> w1 = bufW1_.Get<float>();
        AscendC::LocalTensor<float> w2 = bufW2_.Get<float>();
        AscendC::LocalTensor<float> acc = bufReduce_.Get<float>();
        AscendC::LocalTensor<float> reduceTmp = bufReduceTmp_.Get<float>();

        // mean(x): on-chip reduction; the level-2 API syncs V->S itself.
        AscendC::ReduceSum<float>(acc, xLocal, reduceTmp, LZ_ADALN_ROW_LEN);
        const float mean = acc.GetValue(0) * (1.0f / LZ_ADALN_ROW_LEN);

        // var(x) = mean((x - mean)^2): two-pass, stays in UB.
        AscendC::Adds(w1, xLocal, -mean, LZ_ADALN_ROW_LEN);
        AscendC::Mul(w2, w1, w1, LZ_ADALN_ROW_LEN);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::ReduceSum<float>(acc, w2, reduceTmp, LZ_ADALN_ROW_LEN);
        float var = acc.GetValue(0) * (1.0f / LZ_ADALN_ROW_LEN);
        if (var < 0.0f) {
            var = 0.0f;
        }
        const float rstd = 1.0f / sqrt(var + LZ_ADALN_EPS);

        // y = (x - mean) * rstd * (1 + scale) + shift [+ gate-residual]
        AscendC::Muls(w1, w1, rstd, LZ_ADALN_ROW_LEN);
        AscendC::Adds(w2, scaleLocal, 1.0f, LZ_ADALN_ROW_LEN);

        AscendC::GlobalTensor<float> yGm;
        yGm.SetGlobalBuffer(yBase_ + static_cast<int64_t>(row) * LZ_ADALN_ROW_LEN, LZ_ADALN_ROW_LEN);
        AscendC::LocalTensor<float> yLocal = outQueueY_.AllocTensor<float>();
        AscendC::Mul(yLocal, w1, w2, LZ_ADALN_ROW_LEN);
        AscendC::Add(yLocal, yLocal, shiftLocal, LZ_ADALN_ROW_LEN);
        if (mode_ == LZ_ADALN_MODE_GATE_RESIDUAL) {
            AscendC::Mul(yLocal, yLocal, gateLocal, LZ_ADALN_ROW_LEN);
            AscendC::Add(yLocal, yLocal, xLocal, LZ_ADALN_ROW_LEN);
        }
        outQueueY_.EnQue(yLocal);
        yLocal = outQueueY_.DeQue<float>();
        AscendC::DataCopy(yGm, yLocal, LZ_ADALN_ROW_LEN);
        outQueueY_.FreeTensor(yLocal);
        inQueueX_.FreeTensor(xLocal);
        inQueueShift_.FreeTensor(shiftLocal);
        inQueueScale_.FreeTensor(scaleLocal);
        if (mode_ == LZ_ADALN_MODE_GATE_RESIDUAL) {
            inQueueGate_.FreeTensor(gateLocal);
        }
    }

    AscendC::TPipe* pipe_;
    const __gm__ AdaLNTilingData* tiling_ = nullptr;

    __gm__ float* xBase_ = nullptr;
    __gm__ float* yBase_ = nullptr;
    __gm__ float* shiftBase_ = nullptr;
    __gm__ float* scaleBase_ = nullptr;
    __gm__ float* gateBase_ = nullptr;

    AscendC::TQue<AscendC::TPosition::VECIN, 2> inQueueX_;
    AscendC::TQue<AscendC::TPosition::VECOUT, 2> outQueueY_;
    AscendC::TQue<AscendC::TPosition::VECIN, LZ_ADALN_PARAM_DEPTH> inQueueShift_;
    AscendC::TQue<AscendC::TPosition::VECIN, LZ_ADALN_PARAM_DEPTH> inQueueScale_;
    AscendC::TQue<AscendC::TPosition::VECIN, LZ_ADALN_PARAM_DEPTH> inQueueGate_;

    AscendC::TBuf<AscendC::TPosition::VECCALC> bufW1_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> bufW2_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> bufReduce_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> bufReduceTmp_;

    uint32_t rowBegin_ = 0;
    uint32_t rowCount_ = 0;
    uint32_t chunkT_ = 1;
    uint32_t paramStride_ = LZ_ADALN_ROW_LEN;
    uint32_t mode_ = LZ_ADALN_MODE_GATE_RESIDUAL;
};

extern "C" __global__ __vector__ void lz_adaln_gate_kernel(GM_ADDR x, GM_ADDR shift, GM_ADDR scale,
                                                           GM_ADDR gate, GM_ADDR y, GM_ADDR tiling)
{
    AscendC::TPipe pipe;
    FusedAdaLNGate op(&pipe);
    op.Init(x, shift, scale, gate, y, (__gm__ AdaLNTilingData*)tiling);
    op.Process();
}
