// SPDX-License-Identifier: Apache-2.0
/* P28b: FusedQkNorm — one launch for the two LayerNorm(headDim) calls that the
 * CosyVoice2 DiT attention applies to Q and K (qk_norm=True).
 *
 * Work unit = one (b, t) position: the nh head rows are CONTIGUOUS in the
 * transposed to_heads view (H stride == headDim, host-validated), so each
 * unit is a single nh*headDim-element CopyIn/affine/CopyOut with per-head
 * segment reductions inside. This batches away the per-row queue/event sync
 * that made a naive 64-wide-row kernel 0.75x (SLOWER than eager) on the
 * microbenchmark — see P28 doc, "坑五".
 *
 * Affine rows (q w/b, k w/b) are loaded once through a depth-4 queue cycle
 * and held for the kernel lifetime (loaded exactly once, never rewritten —
 * the P28 overwrite race does not apply; DeQue gives the MTE2->V sync).
 */
#include "kernel_operator.h"
#include "lz_qk_norm_tiling.h"

class FusedQkNorm {
public:
    __aicore__ inline explicit FusedQkNorm(AscendC::TPipe* pipe) : pipe_(pipe) {}

    __aicore__ inline void Init(GM_ADDR q, GM_ADDR k, GM_ADDR qw, GM_ADDR qb, GM_ADDR kw, GM_ADDR kb,
                                GM_ADDR qOut, GM_ADDR kOut, const __gm__ LzQkNormTilingData* tiling)
    {
        const uint32_t blockIdx = AscendC::GetBlockIdx();
        const uint32_t totalUnits = tiling->batches * 2;  // [0,batches)=q, rest=k
        const uint32_t begin = blockIdx * tiling->unitsPerCore;
        if (begin >= totalUnits) {
            unitCount_ = 0;
        } else {
            const uint32_t left = totalUnits - begin;
            unitCount_ = left < tiling->unitsPerCore ? left : tiling->unitsPerCore;
        }
        unitBegin_ = begin;
        batches_ = tiling->batches;
        dimT_ = tiling->dimT;
        nh_ = tiling->nh;
        headDim_ = tiling->headDim;
        segBytes_ = headDim_ * sizeof(float);
        unitElems_ = nh_ * headDim_;
        unitBytes_ = unitElems_ * sizeof(float);
        eps_ = tiling->eps;
        qBase_ = (__gm__ float*)q;
        kBase_ = (__gm__ float*)k;
        qwGm_ = (__gm__ float*)qw;
        qbGm_ = (__gm__ float*)qb;
        kwGm_ = (__gm__ float*)kw;
        kbGm_ = (__gm__ float*)kb;
        qOutBase_ = (__gm__ float*)qOut;
        kOutBase_ = (__gm__ float*)kOut;
        qSb_ = tiling->qStrideB;
        qSt_ = tiling->qStrideT;
        kSb_ = tiling->kStrideB;
        kSt_ = tiling->kStrideT;

        pipe_->InitBuffer(inQueue_, 2, unitBytes_);
        pipe_->InitBuffer(outQueue_, 2, unitBytes_);
        pipe_->InitBuffer(weightQueue_, 4, segBytes_);
        pipe_->InitBuffer(bufW1_, unitBytes_);
        pipe_->InitBuffer(bufW2_, unitBytes_);
        pipe_->InitBuffer(bufReduce_, 64);   // nh sums (8 floats) + alignment
        pipe_->InitBuffer(bufReduceTmp_, 8 * segBytes_);
    }

    __aicore__ inline void Process()
    {
        LoadWeights();
        for (uint32_t i = 0; i < unitCount_; i++) {
            ProcessUnit(unitBegin_ + i);
        }
        FreeWeights();
    }

private:
    __aicore__ inline AscendC::LocalTensor<float> LoadOne(__gm__ float* gmBase)
    {
        AscendC::GlobalTensor<float> gm;
        gm.SetGlobalBuffer(gmBase, headDim_);
        AscendC::LocalTensor<float> local = weightQueue_.AllocTensor<float>();
        AscendC::DataCopy(local, gm, headDim_);
        weightQueue_.EnQue(local);
        return weightQueue_.DeQue<float>();
    }

    __aicore__ inline void LoadWeights()
    {
        weightWQ_ = LoadOne(qwGm_);
        weightQB_ = LoadOne(qbGm_);
        weightKW_ = LoadOne(kwGm_);
        weightKB_ = LoadOne(kbGm_);
    }

    __aicore__ inline void FreeWeights()
    {
        weightQueue_.FreeTensor(weightWQ_);
        weightQueue_.FreeTensor(weightQB_);
        weightQueue_.FreeTensor(weightKW_);
        weightQueue_.FreeTensor(weightKB_);
    }

    __aicore__ inline void ProcessUnit(uint32_t unit)
    {
        // unit u over q:  b = u / T, t = u % T  ->  nh*headDim contiguous elems
        // unit u over k:  same indexing on the k tensor (units [batches, 2*batches))
        const bool isQ = unit < batches_;
        const uint32_t u = isQ ? unit : unit - batches_;
        const uint32_t bi = u / dimT_;
        const uint32_t t = u % dimT_;
        const uint32_t sB = isQ ? qSb_ : kSb_;
        const uint32_t sT = isQ ? qSt_ : kSt_;
        const int64_t offset = static_cast<int64_t>(bi) * sB + static_cast<int64_t>(t) * sT;

        AscendC::GlobalTensor<float> xGm;
        xGm.SetGlobalBuffer((isQ ? qBase_ : kBase_) + offset, unitElems_);
        AscendC::LocalTensor<float> xLocal = inQueue_.AllocTensor<float>();
        AscendC::DataCopy(xLocal, xGm, unitElems_);
        inQueue_.EnQue(xLocal);
        xLocal = inQueue_.DeQue<float>();

        AscendC::LocalTensor<float> w1 = bufW1_.Get<float>();
        AscendC::LocalTensor<float> w2 = bufW2_.Get<float>();
        AscendC::LocalTensor<float> acc = bufReduce_.Get<float>();
        AscendC::LocalTensor<float> reduceTmp = bufReduceTmp_.Get<float>();
        const AscendC::LocalTensor<float> w = isQ ? weightWQ_ : weightKW_;
        const AscendC::LocalTensor<float> bAff = isQ ? weightQB_ : weightKB_;

        // contiguous (B, nh, T, hd) output: T is adjacent, NOT the heads — the
        // unit's nh output segments sit nh-segments apart (T*headDim stride),
        // so the store is 8 x 256B DataCopys after the single DeQue.
        __gm__ float* outBase = isQ ? qOutBase_ : kOutBase_;
        AscendC::LocalTensor<float> yLocal = outQueue_.AllocTensor<float>();

        // Three passes over the nh segments with ONE pipe barrier total:
        // (1) center+square, (2) reduce (V->S per ReduceSum), (3) affine.
        // Putting a PipeBarrier inside the per-head loop flushed the vector
        // pipe 8x per unit and dominated the device time.
        for (uint32_t hIdx = 0; hIdx < nh_; hIdx++) {
            const uint32_t seg = hIdx * headDim_;
            AscendC::LocalTensor<float> xSeg = xLocal[seg];
            AscendC::ReduceSum<float>(acc, xSeg, reduceTmp, headDim_);
            const float mean = acc.GetValue(0) * (1.0f / headDim_);
            mean_[hIdx] = mean;
            AscendC::Adds(w1[seg], xSeg, -mean, headDim_);
            AscendC::Mul(w2[seg], w1[seg], w1[seg], headDim_);
        }
        AscendC::PipeBarrier<PIPE_V>();
        for (uint32_t hIdx = 0; hIdx < nh_; hIdx++) {
            AscendC::ReduceSum<float>(acc, w2[hIdx * headDim_], reduceTmp, headDim_);
            float var = acc.GetValue(0) * (1.0f / headDim_);
            if (var < 0.0f) {
                var = 0.0f;
            }
            rstd_[hIdx] = 1.0f / sqrt(var + eps_);
        }
        for (uint32_t hIdx = 0; hIdx < nh_; hIdx++) {
            const uint32_t seg = hIdx * headDim_;
            AscendC::Muls(w1[seg], w1[seg], rstd_[hIdx], headDim_);
            AscendC::Mul(yLocal[seg], w1[seg], w, headDim_);
            AscendC::Add(yLocal[seg], yLocal[seg], bAff, headDim_);
        }
        outQueue_.EnQue(yLocal);
        AscendC::LocalTensor<float> yDone = outQueue_.DeQue<float>();
        for (uint32_t hIdx = 0; hIdx < nh_; hIdx++) {
            const int64_t outOff =
                ((static_cast<int64_t>(bi) * nh_ + hIdx) * dimT_ + t) * headDim_;
            AscendC::GlobalTensor<float> yGm;
            yGm.SetGlobalBuffer(outBase + outOff, headDim_);
            AscendC::DataCopy(yGm, yDone[hIdx * headDim_], headDim_);
        }
        outQueue_.FreeTensor(yDone);
        inQueue_.FreeTensor(xLocal);
    }

    AscendC::TPipe* pipe_;

    __gm__ float* qBase_ = nullptr;
    __gm__ float* kBase_ = nullptr;
    __gm__ float* qwGm_ = nullptr;
    __gm__ float* qbGm_ = nullptr;
    __gm__ float* kwGm_ = nullptr;
    __gm__ float* kbGm_ = nullptr;
    __gm__ float* qOutBase_ = nullptr;
    __gm__ float* kOutBase_ = nullptr;

    uint32_t qSb_ = 0;
    uint32_t qSt_ = 0;
    uint32_t kSb_ = 0;
    uint32_t kSt_ = 0;

    AscendC::TQue<AscendC::TPosition::VECIN, 2> inQueue_;
    AscendC::TQue<AscendC::TPosition::VECOUT, 2> outQueue_;
    AscendC::TQue<AscendC::TPosition::VECIN, 4> weightQueue_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> bufW1_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> bufW2_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> bufReduce_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> bufReduceTmp_;

    AscendC::LocalTensor<float> weightWQ_;
    AscendC::LocalTensor<float> weightQB_;
    AscendC::LocalTensor<float> weightKW_;
    AscendC::LocalTensor<float> weightKB_;

    float mean_[8];
    float rstd_[8];

    uint32_t unitBegin_ = 0;
    uint32_t unitCount_ = 0;
    uint32_t batches_ = 0;
    uint32_t dimT_ = 1;
    uint32_t nh_ = 8;
    uint32_t headDim_ = 64;
    uint32_t segBytes_ = 256;
    uint32_t unitElems_ = 512;
    uint32_t unitBytes_ = 2048;
    float eps_ = 1e-5f;
};
// NOTE: mean_/rstd_ cap nh_ at 8; the host validates nh <= 8 (real config).

extern "C" __global__ __vector__ void lz_qk_norm_kernel(GM_ADDR q, GM_ADDR k, GM_ADDR qw, GM_ADDR qb,
                                                        GM_ADDR kw, GM_ADDR kb, GM_ADDR qOut,
                                                        GM_ADDR kOut, GM_ADDR tiling)
{
    AscendC::TPipe pipe;
    FusedQkNorm op(&pipe);
    op.Init(q, k, qw, qb, kw, kb, qOut, kOut, (__gm__ LzQkNormTilingData*)tiling);
    op.Process();
}
